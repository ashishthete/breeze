# Breeze Fleet hub configuration.
# Shared token: agents authenticate with it, and operators open the dashboard
# at /?token=<this>. Auto-generated into ~/.breeze-fleet/hub.json if unset.
BREEZE_TOKEN=
# Bind address / port for the hub. Keep it on a trusted network or VPN.
BREEZE_HUB_BIND=127.0.0.1
BREEZE_HUB_PORT=47700
