# Hub: Microsoft Entra (Azure AD) SSO. Omit these to run the hub in dev mode
# (token-only). Create an app registration with a Web redirect URI matching
# AZURE_REDIRECT_URI and a client secret.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:47700/auth/callback
# Optional: require the signed-in user to be in this Entra group (object id).
AZURE_ALLOWED_GROUP=
# Signs session cookies. Set to a long random string in production.
SESSION_SECRET=
# Shared enrollment token for agents (also auto-generated into ~/.breeze-fleet/hub.json).
BREEZE_TOKEN=
# Bind address / port for the hub.
BREEZE_HUB_BIND=127.0.0.1
BREEZE_HUB_PORT=47700
